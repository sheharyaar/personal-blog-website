<section class="giscus mx-auto mt-10 w-full"></section>

<script is:inline>
  (() => {
    const siteTheme = () => (document.documentElement.classList.contains("dark") ? "dark" : "light")

    // Added from here rather than written in the HTML, so comments start in the reader's theme.
    const giscus = document.createElement("script")
    giscus.src = "https://giscus.app/client.js"
    giscus.async = true
    giscus.crossOrigin = "anonymous"
    const settings = {
      repo: "sheharyaar/personal-blog-website",
      "repo-id": "R_kgDOMrGb6A",
      category: "Blog Discussion",
      "category-id": "DIC_kwDOMrGb6M4CiKXV",
      mapping: "url",
      strict: "0",
      "reactions-enabled": "1",
      "emit-metadata": "0",
      "input-position": "bottom",
      theme: siteTheme(),
      lang: "en",
      loading: "lazy",
    }
    for (const [name, value] of Object.entries(settings)) giscus.setAttribute(`data-${name}`, value)
    document.querySelector("section.giscus").append(giscus)

    // Follow the theme button afterwards.
    new MutationObserver(() => {
      document
        .querySelector("iframe.giscus-frame")
        ?.contentWindow.postMessage({ giscus: { setConfig: { theme: siteTheme() } } }, "https://giscus.app")
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })
  })()
</script>
