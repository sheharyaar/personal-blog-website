---
// Floating back-to-top button whose ring fills as the article is read.
---

<button id="reading-progress" class="reading-progress" type="button" aria-label="Back to top of page">
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <circle class="reading-progress-track" cx="24" cy="24" r="21" />
    <circle class="reading-progress-ring" cx="24" cy="24" r="21" pathLength="1" />
    <path class="reading-progress-arrow" d="M24 32V16M17 23l7-7 7 7" />
  </svg>
</button>

<script>
  const button = document.getElementById("reading-progress")!
  const article = document.querySelector("main article")
  let queued = false

  function update() {
    queued = false
    if (article) {
      // 0 when the article's top reaches the top of the screen, 1 when its end reaches the bottom.
      const box = article.getBoundingClientRect()
      const distance = box.height - innerHeight
      const read = distance > 0 ? Math.min(1, Math.max(0, -box.top / distance)) : 1
      button.style.setProperty("--read", String(read))
    }
    button.classList.toggle("is-visible", scrollY > 300)
  }

  function queue() {
    if (queued) return
    queued = true
    requestAnimationFrame(update)
  }

  addEventListener("scroll", queue, { passive: true })
  addEventListener("resize", queue)
  button.addEventListener("click", () => {
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches
    scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" })
  })
  update()
</script>
