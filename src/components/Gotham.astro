---
// Night-time Gotham behind the hero: sky, moonlit clouds, the bat-signal and
// its beam, and a skyline whose windows light up in dark mode.
// Light mode keeps only a soft daytime skyline.
// The skyline paths were generated once by a small script (seeded RNG); they
// are plain path data, so tweak by hand or regenerate if you want a new city.
import { BAT_PATH } from "@lib/bat"
import { cn } from "@lib/utils"

type Props = {
  // An empty signal (no bat) for pages like the 404.
  empty?: boolean
  class?: string
}

const { empty = false, class: className } = Astro.props
---

<div class={cn("gotham", className)} aria-hidden="true">
  <div class="gotham-sky"></div>

  <svg class="gotham-clouds" viewBox="0 0 1600 600" preserveAspectRatio="none">
    <filter id="gotham-cloud-noise" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.0085" numOctaves="4" seed="27" />
      <feColorMatrix type="matrix" values="0 0 0 0 0.62  0 0 0 0 0.67  0 0 0 0 0.78  0 0 0 1.7 -0.78" />
    </filter>
    <rect width="1600" height="600" filter="url(#gotham-cloud-noise)" />
  </svg>

  <div class="gotham-beam-wrap">
    <div class="gotham-beam"></div>
  </div>

  <div class="gotham-signal">
    <svg viewBox="0 0 200 100">
      <defs>
        <radialGradient id="gotham-signal-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#fff4cf" stop-opacity="0.95" />
          <stop offset="0.6" stop-color="#f0d68c" stop-opacity="0.78" />
          <stop offset="0.86" stop-color="#e0bd67" stop-opacity="0.25" />
          <stop offset="1" stop-color="#e0bd67" stop-opacity="0" />
        </radialGradient>
        <filter id="gotham-signal-soft">
          <feGaussianBlur stdDeviation="1.1" />
        </filter>
      </defs>
      <ellipse cx="100" cy="50" rx="100" ry="50" fill="url(#gotham-signal-glow)" />
      {!empty && (
        <path
          d={BAT_PATH}
          transform="translate(38 15.3) scale(0.62)"
          fill="#0d1422"
          fill-opacity="0.9"
          filter="url(#gotham-signal-soft)"
        />
      )}
    </svg>
  </div>

