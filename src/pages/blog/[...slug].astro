---
import { type CollectionEntry, getCollection } from "astro:content"
import ArticleLayout from "@layouts/ArticleLayout.astro"

// Create the static blog pages
export async function getStaticPaths() {
	// Drafts are only built in `astro dev`, so they can be previewed but never published.
	const posts = await getCollection("blog", (entry) => import.meta.env.DEV || !entry.data.draft)
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}))
}

type Props = CollectionEntry<"blog">
---

<ArticleLayout entry={Astro.props} />
