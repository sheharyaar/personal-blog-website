---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import TagCloud from "@components/TagCloud.astro"
import { formatMonthDay } from "@lib/utils"
import { countTags, tagHref } from "@lib/content"
import { BLOG } from "@consts"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const years = Map.groupBy(posts, (post) => post.data.date.getFullYear())

const tags = countTags(posts)
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">{BLOG.TITLE}</div>
    <p class="animate mt-6">{BLOG.DESCRIPTION}</p>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <TagCloud tags={tags} />
      {
        [...years].map(([year, items]) => (
          <section class="archive-year">
            <h2>{year}</h2>
            <ul class="archive-list">
              {items.map((post) => (
                <li>
                  <time datetime={post.data.date.toISOString()}>{formatMonthDay(post.data.date)}</time>
                  <div>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    <p>{post.data.summary}</p>
                    <ul class="archive-tags">
                      {post.data.tags.map((tag) => <li><a href={tagHref(tag)}>#{tag}</a></li>)}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </BottomLayout>
</PageLayout>
