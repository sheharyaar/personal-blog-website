---
import { getCollection, render } from "astro:content"
import { Image } from "astro:assets"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { covers } from "@lib/covers"
import { tagSlug } from "@lib/content"
import { LIBRARY } from "@consts"

// Library convention: "The Prince" files under P.
const sortTitle = (title: string) => title.replace(/^(the|an|a)\s+/i, "")

const entries = (await getCollection("library"))
  .filter((book) => import.meta.env.DEV || !book.data.draft)
  .sort((a, b) => sortTitle(a.data.title).localeCompare(sortTitle(b.data.title)))

// The text under a book's properties is its note; most books won't have one.
const books = await Promise.all(
  entries.map(async (book) => ({
    id: book.id,
    ...book.data,
    cover: covers.get(tagSlug(book.id)),
    Note: book.body?.trim() ? (await render(book)).Content : null,
  })),
)

const subjects = [...Map.groupBy(books, (book) => book.subject)]
  .map(([subject, items]) => ({ subject, slug: tagSlug(subject), items, fan: items.flatMap((book) => book.cover ?? []).slice(0, 3) }))
  .sort((a, b) => a.subject.localeCompare(b.subject))

// How many columns and shared rows a subject takes in the 6- and 8-across layouts; the extra row is its heading.
const spanVars = (count: number) =>
  [6, 8].map((across) => `--cols-${across}:${Math.min(count, across)};--rows-${across}:${1 + 2 * Math.ceil(count / across)}`).join(";")

const coverWidths = [120, 240, 320]
const coverSizes = "(min-width: 640px) 110px, 30vw"
---

<PageLayout title={LIBRARY.TITLE} description={LIBRARY.DESCRIPTION}>
  <div data-pagefind-body data-pagefind-filter="section:Library">
    <TopLayout size="lg">
      <h1 class="animate page-heading">{LIBRARY.TITLE}</h1>
      <p class="animate mt-6">{LIBRARY.DESCRIPTION} {books.length} of them.</p>
    </TopLayout>
    <BottomLayout size="lg">
      <div class="animate">
        <nav class="stacks" aria-label="Jump to a subject" data-pagefind-ignore="all">
          {
            subjects.map(({ subject, slug, items, fan }) => (
              <a class="stack" href={`#${slug}`}>
                <span class="stack-fan" aria-hidden="true">
                  {fan.map((cover) => <Image src={cover} alt="" widths={[60, 120]} sizes="38px" />)}
                </span>
                <span class="stack-name">{subject}</span>
                <span class="tag-count">{items.length}</span>
              </a>
            ))
          }
        </nav>

        <ul class="tag-list library-filter" aria-label="Filter by subject" data-pagefind-ignore>
          <li>
            <button type="button" data-subject="" aria-pressed="true">All <span class="tag-count">{books.length}</span></button>
          </li>
          {
            subjects.map(({ subject, slug, items }) => (
              <li>
                <button type="button" data-subject={slug} aria-pressed="false">
                  {subject} <span class="tag-count">{items.length}</span>
                </button>
              </li>
            ))
          }
        </ul>

        <div class="library-shelves">
          {
            subjects.map(({ subject, slug, items }) => (
              <section class="archive-year library-subject" id={slug} data-subject={slug} style={spanVars(items.length)}>
                <h2>{subject}</h2>
                <ul class="book-grid">
                  {items.map((book) => (
                    <li>
                      <button type="button" class="book" data-reading={book.status === "reading" || undefined} popovertarget={`book-${book.id}`} title={`${book.title} by ${book.author}`}>
                        <span class="book-cover">
                          {book.cover ? (
                            <Image src={book.cover} alt="" widths={coverWidths} sizes={coverSizes} />
                          ) : (
                            <span class="book-plain" aria-hidden="true">
                              <span class="book-plain-title">{book.title}</span>
                              <span class="book-plain-author">{book.author}</span>
                            </span>
                          )}
                          {book.status && book.status !== "unread" && <span class="book-badge">{book.status}</span>}
                          {book.Note && <span class="book-note-dot"><span class="sr-only">Has a note</span></span>}
                        </span>
                        <span class="book-caption">
                          <span class="book-caption-title">{book.title}</span>
                          <span class="book-caption-author">{book.author}</span>
                        </span>
                      </button>

                      <div id={`book-${book.id}`} popover class="book-card">
                        {book.cover && <Image src={book.cover} alt="" widths={coverWidths} sizes={coverSizes} class="book-card-cover" />}
                        <div class="book-card-body">
                          <h3>{book.title}</h3>
                          <p class="book-card-author">{book.author}</p>
                          <p class="book-card-meta">{book.subject}{book.status && ` · ${book.status}`}</p>
                          {book.Note && (
                            <article class="book-card-note prose dark:prose-invert">
                              <book.Note />
                            </article>
                          )}
                        </div>
                        <button type="button" class="book-card-close" popovertarget={`book-${book.id}`} popovertargetaction="hide" aria-label="Close">×</button>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <p class="library-credit" data-pagefind-ignore>Most cover images from <a href="https://openlibrary.org" target="_blank">Open Library</a>.</p>
      </div>
    </BottomLayout>
  </div>
</PageLayout>

<script>
  const filter = document.querySelector<HTMLElement>(".library-filter")!
  const chips = [...filter.querySelectorAll("button")]
  const shelves = document.querySelector<HTMLElement>(".library-shelves")!
  const sections = shelves.querySelectorAll<HTMLElement>(".library-subject")

  function show(subject: string) {
    const active = chips.find((chip) => chip.dataset.subject === subject) ?? chips[0]
    const chosen = active.dataset.subject
    for (const chip of chips) chip.setAttribute("aria-pressed", String(chip === active))
    for (const section of sections) section.hidden = Boolean(chosen) && section.dataset.subject !== chosen
    shelves.toggleAttribute("data-filtered", Boolean(chosen))
    // On phones the chips are one scrolling row, so keep the active one in view.
    filter.scrollLeft += active.getBoundingClientRect().left - filter.getBoundingClientRect().left - 20
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      show(chip.dataset.subject!)
      history.replaceState(null, "", chip.dataset.subject ? `?subject=${chip.dataset.subject}` : location.pathname)
    })
  }

  // The chips only exist on phones, so wider screens always list everything: a shared filter
  // link would otherwise hide books with no way to get them back.
  const phone = matchMedia("(max-width: 639px)")
  const applyLink = () => show(phone.matches ? (new URLSearchParams(location.search).get("subject") ?? "") : "")
  phone.addEventListener("change", applyLink)
  applyLink()
</script>
